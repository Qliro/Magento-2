{
    "name": "qliro/module-qliroone-tools",
    "description": "Static analysis tools, kept apart from the module so their dependencies never meet Magento's",
    "type": "project",
    "license": "proprietary",
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "magento/magento-coding-standard": "^41",
        "bitexpert/phpstan-magento": "^0.44.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    }
}
