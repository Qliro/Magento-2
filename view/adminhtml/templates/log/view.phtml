                    <?php
                        $extra   = $log->getExtra();
                        $decoded = json_decode($extra, true);

                        if ($decoded !== null) {
                            $extraFormatted = json_encode($decoded, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
                            $extraType      = 'json';
                        } elseif (preg_match('/^\s*Array\s*\(/m', $extra)) {
                            $extraFormatted = $extra;
                            $extraType      = 'phparray';
                        } else {
                            $extraFormatted = $extra;
                            $extraType      = 'text';
                        }
                    ?>
                    <?php if ($extraType === 'text'): ?>
                        <textarea readonly rows="8" style="width: 100%; box-sizing: border-box; font-family: monospace; font-size: 12px; resize: vertical;"
                        ><?= $block->escapeHtml($extraFormatted) ?></textarea>
                    <?php else: ?>
                        <pre id="qliroone-extra-pre" style="
                            margin: 0;
                            padding: 10px;
                            background: #fff;
                            border-radius: 4px;
                            font-family: monospace;
                            font-size: 12px;
                            line-height: 1.5;
                            overflow: auto;
                            max-height: 500px;
                            white-space: pre-wrap;
                            word-break: break-all;
                            border: 1px solid #d6d6d6;
                        "></pre>
                        <script>
                        (function () {
                            const raw  = <?= /* @noEscape */ json_encode($extraFormatted) ?>;
                            const type = <?= /* @noEscape */ json_encode($extraType) ?>;

                            function esc(s) {
                                return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
                            }

                            function span(color, text) {
                                return '<span style="color:' + color + '">' + esc(text) + '</span>';
                            }

                            function highlightJson(str) {
                                const re = /("(?:\\.|[^"\\])*"(?:\s*:)?|true|false|null|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g;
                                let result = '', last = 0, m;
                                while ((m = re.exec(str)) !== null) {
                                    result += esc(str.slice(last, m.index));
                                    const tok = m[0];
                                    let color;
                                    if (tok.startsWith('"')) {
                                        color = tok.trimEnd().endsWith(':') ? '#0451a5' : '#b5501a';
                                    } else if (tok === 'true' || tok === 'false') {
                                        color = '#0000ff';
                                    } else if (tok === 'null') {
                                        color = '#808080';
                                    } else {
                                        color = '#098658';
                                    }
                                    result += span(color, tok);
                                    last = m.index + tok.length;
                                }
                                return result + esc(str.slice(last));
                            }

                            function highlightPhpArray(str) {
                                return str.replace(/\\n/g, '\n').split('\n').map(function (line) {
                                    const arrowLine = line.match(/^(\s*)\[([^\]]*)\]\s*=>\s*(.*)$/);
                                    if (arrowLine) {
                                        const indent = esc(arrowLine[1]);
                                        const key    = arrowLine[2];
                                        const value  = arrowLine[3].trim();
                                        const valHtml = (value === 'Array' || value === '')
                                            ? span('#0000ff', 'Array')
                                            : span('#b5501a', value);
                                        return indent
                                            + '[' + span('#0451a5', key) + ']'
                                            + ' ' + span('#808080', '=>') + ' '
                                            + valHtml;
                                    }

                                    if (/^\s*Array\s*$/.test(line)) {
                                        return esc(line).replace('Array', span('#0000ff', 'Array'));
                                    }

                                    return esc(line);
                                }).join('\n');
                            }

                            const normalized = raw.replace(/\\n/g, '\n').replace(/\\t/g, '    ');
                            document.getElementById('qliroone-extra-pre').innerHTML =
                                type === 'json' ? highlightJson(normalized) : highlightPhpArray(normalized);
                        })();
                        </script>
                    <?php endif; ?>
