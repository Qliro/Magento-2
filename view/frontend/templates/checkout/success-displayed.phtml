/** @var \Qliro\QliroOne\Block\Checkout\Success $block */
/** @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer */

$flags = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT;
$url = json_encode($block->getDisplayedUrl(), $flags);
$order = json_encode((string)$block->getOrderId(), $flags);

// Plain script rather than a RequireJS widget, so it runs in any theme
$script = <<<JS
(function () {
    var attempts = 0;

    function report() {
        attempts++;
        fetch($url, {
            method: 'POST',
            keepalive: true,
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: 'order=' + encodeURIComponent($order)
        }).then(function (response) {
            if (!response.ok) {
                retry();
            }
        }, retry);
    }

    function retry() {
        if (attempts < 3) {
            setTimeout(report, 2000);
        }
    }

    function whenLoaded() {
        if (document.readyState === 'complete') {
            report();
        } else {
            window.addEventListener('load', report);
        }
    }

    // A frame is not the page the buyer sees
    if (window.top !== window.self) {
        return;
    }

    // A prerendered page holds its tags until it is shown, and may never be
    if (document.prerendering) {
        document.addEventListener('prerenderingchange', whenLoaded, {once: true});
    } else {
        whenLoaded();
    }
})();
JS;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $script, false) ?>
