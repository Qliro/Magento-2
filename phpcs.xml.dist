<?xml version="1.0"?>
<ruleset name="Qliro_QliroOne">
    <description>Magento coding standard, errors only.</description>
    <file>Api</file>
    <file>Block</file>
    <file>Console</file>
    <file>Controller</file>
    <file>Cron</file>
    <file>Gateway</file>
    <file>Helper</file>
    <file>Model</file>
    <file>Observer</file>
    <file>Plugin</file>
    <file>Service</file>
    <file>Setup</file>
    <file>Ui</file>
    <file>ViewModel</file>
    <file>view</file>
    <file>registration.php</file>
    <arg name="extensions" value="php,phtml"/>
    <arg name="warning-severity" value="0"/>
    <arg value="ps"/>

    <rule ref="Magento2"/>
    <config name="testVersion" value="8.2-"/>

    <!-- Baseline: errors present when the standard was introduced. Remove an entry once fixed. -->
    <rule ref="Magento2.Security.InsecureFunction.Found">
        <exclude-pattern>*/Helper/Data\.php$</exclude-pattern>
    </rule>
    <rule ref="Magento2.Security.InsecureFunction.FoundWithAlternative">
        <exclude-pattern>*/Model/Management/Quote\.php$</exclude-pattern>
    </rule>
    <rule ref="Magento2.PHP.FinalImplementation.FoundFinal">
        <exclude-pattern>*/Model/QliroOrder/Admin/Builder/Handler/AppliedRulesHandler\.php$</exclude-pattern>
        <exclude-pattern>*/Model/QliroOrder/Admin/Builder/Handler/RoundingAdjustmentHandler\.php$</exclude-pattern>
        <exclude-pattern>*/Model/QliroOrder/Builder/Handler/AppliedRulesHandler\.php$</exclude-pattern>
        <exclude-pattern>*/Model/QliroOrder/Builder/Handler/RoundingAdjustmentHandler\.php$</exclude-pattern>
    </rule>
</ruleset>
