{
    "name": "qliro/module-qliroone",
    "type": "magento2-module",
    "description": "QliroOne checkout integration for Magento 2",
    "license": "proprietary",
    "version": "1.8.49",
    "authors": [
        {
            "name": "Andreas Wickberg",
            "email": "andreas.wickberg@vaimo.com"
        },
        {
            "name": "Kjell Holmqvist",
            "email": "kjell.holmqvist@vaimo.com"
        },
        {
            "name": "Volodymyr Butenko",
            "email": "vova@newamsterdam.se"
        }
    ],
    "require": {
        "ext-json": "*",
        "magento/framework": "^103.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "magento/module-quote": "^101.2",
        "magento/module-inventory-sales-api": "^1.2",
        "magento/module-inventory-catalog-api": "^1.3",
        "magento/module-inventory-configuration-api": "^1.2"
    },
    "suggest": {
        "magento/module-inventory-sales-api": "Decide stock the way Multi Source Inventory decides it",
        "magento/module-inventory-catalog-api": "Decide stock the way Multi Source Inventory decides it",
        "magento/module-inventory-configuration-api": "Decide stock the way Multi Source Inventory decides it"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Qliro\\QliroOne\\": ""
        }
    },
    "repositories": [
        {
            "url": "https://repo.magento.com/",
            "type": "composer"
        }
    ],
    "support": {
        "issues": "https://github.com/Qliro/Magento-2/wiki"
    },
    "scripts": {
        "tools": "@composer install --working-dir=tools --no-interaction --no-progress",
        "test": "phpunit",
        "phpstan": "tools/vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "phpcs": "tools/vendor/bin/phpcs",
        "static-analysis": [
            "@tools",
            "@phpstan",
            "@phpcs"
        ]
    },
    "scripts-descriptions": {
        "tools": "Install PHPStan and the Magento coding standard into tools/",
        "test": "Run the unit tests",
        "phpstan": "Run PHPStan at the level in phpstan.neon.dist",
        "phpcs": "Check the Magento coding standard",
        "static-analysis": "Install the tools, then run PHPStan and the coding standard"
    },
    "config": {
        "allow-plugins": false
    }
}
