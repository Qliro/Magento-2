<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Model\CompositeConfigProvider">
        <arguments>
            <argument name="configProviders" xsi:type="array">
                <item name="checkout_qliro_config" xsi:type="object">Qliro\QliroOne\Model\CheckoutConfigProvider</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Checkout\Block\Checkout\LayoutProcessor">
        <plugin name="qliroone_onepage" type="Qliro\QliroOne\Plugin\Block\Checkout\LayoutProcessorPlugin" sortOrder="99999" />
    </type>

    <type name="Magento\Checkout\Model\Type\Onepage">
        <plugin name="qliroone_onepage" type="Qliro\QliroOne\Plugin\Model\Type\Onepage" />
    </type>

    <type name="Magento\Checkout\Model\Cart">
        <plugin name="qliro_prevent_cart_changes_when_locked" type="Qliro\QliroOne\Plugin\PreventChangeInCartWhenLocked\Cart"/>
    </type>

    <type name="Magento\Checkout\Controller\Cart\CouponPost">
        <plugin name="qliro_prevent_coupon_changes_when_locked" type="Qliro\QliroOne\Plugin\PreventChangeInCartWhenLocked\Coupon"/>
    </type>

    <type name="Magento\Customer\Model\AccountManagement">
        <plugin name="qliro_prevent_login_in_when_locked" type="Qliro\QliroOne\Plugin\PreventChangeInCartWhenLocked\Login"/>
    </type>

    <type name="Magento\Customer\Controller\Account\Logout">
        <plugin name="qliro_prevent_logout_in_when_locked" type="Qliro\QliroOne\Plugin\PreventChangeInCartWhenLocked\Logout"/>
    </type>

    <!-- Magento sets the store and currency of the vary cookie only for the deprecated action base -->
    <type name="Qliro\QliroOne\Controller\Checkout\Totals">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Link\Expire">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Qliro\Ajax\AbstractLockQuote">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Qliro\Ajax\GetSnippet">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Qliro\Ajax\PollPending">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Qliro\Ajax\SetRecurring">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Qliro\Ajax\UpdateCountry">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Qliro\Ajax\UpdateCustomer">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Qliro\Ajax\UpdatePaymentMethod">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Qliro\Ajax\UpdateQuote">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Qliro\Ajax\UpdateRecurring">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Qliro\Ajax\UpdateShippingMethod">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Qliro\Ajax\UpdateShippingPrice">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Qliro\Recurring\Cancel">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
    <type name="Qliro\QliroOne\Controller\Qliro\Recurring\History">
        <plugin name="qliroone_keep_vary_cookie" type="Qliro\QliroOne\Plugin\Controller\KeepVaryCookie" />
    </type>
</config>
